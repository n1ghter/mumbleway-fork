<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android's backup service carries, on Android 11 and earlier.

  FlutterSharedPreferences.xml is excluded so plaintext preferences never leave
  the device in cloud backup. Nothing outside <include> is backed up, so the
  client identity under files/ and noBackupFilesDir/secrets.enc stay on this
  device. See data_extraction_rules.xml for Android 12+.
-->
<full-backup-content>
    <include domain="sharedpref" path="."/>
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
</full-backup-content>
