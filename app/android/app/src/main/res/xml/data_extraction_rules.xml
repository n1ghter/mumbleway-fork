<?xml version="1.0" encoding="utf-8"?>
<!--
  What leaves this device, on Android 12 and later.

  FlutterSharedPreferences.xml is excluded from cloud-backup so plaintext
  preferences never leave the device for Google's servers, and noBackupFilesDir
  (holding secrets.enc) is always excluded by the OS.

  device-transfer is the direct handover between an old phone and a new one
  during setup. identity.key is omitted from device-transfer so the client TLS
  private key never leaves the device; a new device generates its own identity
  keypair on first start.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="identity.crt"/>
    </device-transfer>
</data-extraction-rules>
